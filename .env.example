# Copy to .env and adjust. Never commit the real .env.

# --- Database -----------------------------------------------------------------
# The application connects as a LEAST-PRIVILEGE role (recon_app) that deliberately
# holds no UPDATE/DELETE grant on audit_log or on posted match rows.
# See docs/05_AI_GUARDRAILS_SPEC.md section 4 and migrations/versions/0002_*.py.
DATABASE_URL=postgresql+psycopg://recon_app:recon_app_pw@localhost:5432/recon

# The owner role, used only by `alembic upgrade` to run DDL and issue grants.
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recon

# --- API auth -----------------------------------------------------------------
# Buildathon scope: symmetric-key JWT. Production would use a managed IdP.
# docs/05_AI_GUARDRAILS_SPEC.md section 4 documents the pattern.
JWT_SECRET=change-me-in-any-real-deployment
JWT_ALGORITHM=HS256

# --- Embedding layer ----------------------------------------------------------
# Optional. Absent => the semantic pass is skipped and reported as skipped,
# never silently treated as "no matches found".
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Determinism --------------------------------------------------------------
# Fixed seed so every reported number is reproducible by a judge.
SYNTHETIC_SEED=20260822
